# Address of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: WebRTC servers as JSON. Defaults to Google's public STUN server.
# Add a TURN server here if people on strict networks can't see each other's video.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
