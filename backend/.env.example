# Copy to .env for local overrides (optional; defaults work for local dev)
DATABASE_URL=sqlite:///./zoom.db
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Video calls between strict networks (phone data, many home routers) need a
# TURN relay. Set ONE option:
# a) Cloudflare Realtime TURN (free tier)
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# b) Any other TURN server (comma separated URLs)
# TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Optional: send all video through the relay (hides IP addresses from each other)
# TURN_FORCE_RELAY=false
